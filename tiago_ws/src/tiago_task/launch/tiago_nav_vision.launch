<?xml version="1.0" encoding="UTF-8"?>
<launch>

  <!-- ===== 通用参数 ===== -->
  <!-- 是否公开仿真（和原导航文件一致） -->
  <arg name="public_sim"   default="true"/>

  <!-- 世界名：和 tiago_navigation.launch 里的 world 一致 -->
  <arg name="world"  default="wrs2020"/>

  <!-- 机器人在 Gazebo 中的初始位姿：直接用你现在用的那一串 -->
  <arg name="gzpose" default="-x -1.565665 -y 0.576238 -z 0.0 -Y 0.398122"/>

  <!-- 地图路径：直接用你现在的绝对路径 -->
  <arg name="map" default="/tiago_ws/src/tmc_wrs_gazebo_world/maps/wrs2020"/>

  <!-- 是否打开 Gazebo GUI / RViz（导航自带的 RViz 我们关掉，自己开视觉用的 RViz） -->
  <arg name="gzclient" default="true"/>
  <arg name="rviz_nav" default="false"/>   <!-- 传给导航的 RViz 开关 -->
  <arg name="rviz_vision" default="true"/> <!-- 我们自己起的 RViz -->

  <!-- 其他和导航文件一致的参数，按需暴露/转发 -->
  <arg name="namespace" default="/"/>
  <arg name="robot"  default="titanium"/>
  <arg name="arm"  default="$(eval {'iron': False}.get(arg('robot'), True))"/>
  <arg name="end_effector"  default="pal-gripper"/>
  <arg name="ft_sensor"  default="$(eval {'titanium': 'schunk-ft'}.get(arg('robot'), 'false'))"/>
  <arg name="laser_model"  default="sick-571"/>
  <arg name="camera_model"  default="orbbec-astra"/>
  <arg name="base_type" default="pmb2"/>
  <arg name="tuck_arm"  default="true"/>

  <arg name="lost" default="false"/>
  <arg name="planner"        default="base"/>
  <arg name="global_planner" default="global_planner"/>
  <arg name="local_planner"  default="$(eval 'teb' if (arg('public_sim') or arg('base_type')=='omni_base') else 'pal')"/>
  <arg name="localization"   default="amcl"/>
  <arg name="recording" default="false"/>
  <arg name="extra_gazebo_args" default=""/>

  <arg name="advanced_navigation"   default="false"/> <!-- 原文件里也有 -->
  <arg name="sim_sufix" value="_public_sim"     if="$(arg public_sim)"/>
  <arg name="sim_sufix" value=""                unless="$(arg public_sim)"/>

  <!-- 额外：为了使用 object_detection_world 的模型 -->
  <env name="GAZEBO_MODEL_PATH"
       value="$(optenv GAZEBO_MODEL_PATH):$(find object_detection_world)/models:$(find tiago_gazebo)/models"/>
  <env name="LC_NUMERIC" value="C" />
  <env name="PAL_HOST" value="tiago" />

  <!-- ========= 1. 启动仿真 + 导航（以 tiago_navigation.launch 为核心） ========= -->
  <group ns="$(arg namespace)">

    <!-- 这里直接 include 你原来的 tiago_navigation.launch，
         但把 rviz 关掉（rviz:=false），避免和我们自己开的 RViz 冲突 -->
    <include file="$(find tiago_2dnav_gazebo)/launch/tiago_navigation.launch">

      <arg name="namespace" value="$(arg namespace)"/>
      <arg name="public_sim"   value="$(arg public_sim)"/>

      <arg name="robot"  value="$(arg robot)"/>
      <arg name="arm"  value="$(arg arm)"/>
      <arg name="end_effector"  value="$(arg end_effector)"/>
      <arg name="ft_sensor"  value="$(arg ft_sensor)"/>
      <arg name="laser_model"  value="$(arg laser_model)"/>
      <arg name="camera_model"  value="$(arg camera_model)"/>
      <arg name="base_type" value="$(arg base_type)"/>

      <arg name="world"  value="$(arg world)"/>
      <arg name="tuck_arm"  value="$(arg tuck_arm)"/>

      <arg name="lost" value="$(arg lost)"/>
      <arg name="gzpose" value="$(arg gzpose)"/>

      <arg name="planner"        value="$(arg planner)"/>
      <arg name="global_planner" value="$(arg global_planner)"/>
      <arg name="local_planner"  value="$(arg local_planner)"/>
      <arg name="localization"   value="$(arg localization)"/>
      <arg name="map"            value="$(arg map)"/>

      <!-- 关键：这里把导航自带的 RViz 关掉 -->
      <arg name="rviz"     value="$(arg rviz_nav)"/>
      <arg name="gzclient" value="$(arg gzclient)"/>
      <arg name="recording" value="$(arg recording)"/>
      <arg name="extra_gazebo_args" value="$(arg extra_gazebo_args)"/>

      <arg name="advanced_navigation"   value="$(arg advanced_navigation)"/>

    </include>

  </group>

  <!-- ========= 2. 视觉相关节点（来自 object_detection_world/tiago.launch） ========= -->

  <!-- 点云 throttle/filter：只在非 public_sim 模式下启用，保持原逻辑 -->
  <group unless="$(arg public_sim)">
    <include file="$(find pal_pcl_points_throttle_and_filter)/launch/throttle_filtering_points.launch">
      <arg name="cloud"  value="/xtion/depth_registered/points"/>
    </include>
  </group>

  <!-- image_proc：对 xtion 的 rgb 图跑 image_proc -->
  <!--node name="image_proc" pkg="image_proc" type="image_proc" ns="xtion/rgb"/-->

  <!-- 用 object_detection_world 提供的 RViz 配置打开 RViz -->
  <node name="rviz" pkg="rviz" type="rviz"
        if="$(arg rviz_vision)"
        args="-d $(find object_detection_world)/config/tiago.rviz"
        required="true" />

</launch>
