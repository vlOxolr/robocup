<launch>
  <node pkg="ordering" type="inventory_manager.py" name="inventory_manager" output="screen">
    <rosparam param="initial_inventory">
      Cola: 5
      Apple: 10
      Burger: 3
    </rosparam>
    <param name="publish_rate_hz" value="1.0" />
  </node>

  <node pkg="ordering" type="web_order_server.py" name="web_order_server" output="screen">
    <rosparam param="menu_items">
      - Cola
      - Apple
      - Burger
    </rosparam>
    <param name="host" value="0.0.0.0" />
    <param name="port" value="9082" />
    <param name="status_publish_hz" value="1.0" />
  </node>

  <!-- order_manager: provides /orders/set_status and publishes updates to /orders/status -->
  <node pkg="ordering" type="order_manager.py" name="order_manager" output="screen" />
</launch>
